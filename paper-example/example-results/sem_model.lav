ATT =~ ATT_1 + ATT_2 + ATT_3 + ATT_4
INT =~ INT_1 + INT_2 + INT_3
SUB_NORM =~ SUB_NORM_1 + SUB_NORM_2 + SUB_NORM_3
PBC =~ PBC_1 + PBC_2 + PBC_3 + PBC_4
MORAL_NORM =~ MORAL_NORM_1 + MORAL_NORM_2 + MORAL_NORM_3 + MORAL_NORM_4
KNOWLEDGE =~ KNOWLEDGE_1 + KNOWLEDGE_2
INT ~ ATT + MORAL_NORM + SUB_NORM + PBC + KNOWLEDGE
PBC ~ ATT + KNOWLEDGE + MORAL_NORM + SUB_NORM
ATT ~ KNOWLEDGE + MORAL_NORM + SUB_NORM
MORAL_NORM ~ KNOWLEDGE
SUB_NORM ~ KNOWLEDGE
KNOWLEDGE~~ 0*SUB_NORM
KNOWLEDGE~~ 0*MORAL_NORM
KNOWLEDGE~~ 0*ATT
KNOWLEDGE~~ 0*PBC
KNOWLEDGE~~ 0*INT
SUB_NORM~~ 0*MORAL_NORM
SUB_NORM~~ 0*ATT
SUB_NORM~~ 0*PBC
SUB_NORM~~ 0*INT
MORAL_NORM~~ 0*ATT
MORAL_NORM~~ 0*PBC
MORAL_NORM~~ 0*INT
ATT~~ 0*PBC
ATT~~ 0*INT
PBC~~ 0*INT
